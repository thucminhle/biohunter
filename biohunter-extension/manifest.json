{
  "manifest_version": 3,
  "name": "BioHunter Capture",
  "version": "0.2.0",
  "description": "Click-to-save the job posting you're viewing into your local BioHunter dashboard.",

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "options_page": "options.html",

  "permissions": ["activeTab", "scripting", "storage", "windows"],

  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
